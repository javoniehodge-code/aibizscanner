# Copy to web/.env.local for local development. Never commit real values.
# In Vercel, set the same names under Project → Settings → Environment Variables.

# Supabase project URL — Supabase dashboard → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase publishable key (or the legacy "anon" key) — Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) ---
# Supabase secret key (or legacy service_role key) — Project Settings → API Keys → secret key. Used only by the worker.
SUPABASE_SECRET_KEY=sb_secret_placeholder
# Shared secret for /api/worker/tick (Authorization: Bearer ...). Generate with: openssl rand -hex 32
# Store the same value in Supabase Vault as worker_cron_secret.
CRON_SECRET=replace-with-64-hex-characters

# --- AI providers (Milestone 2: prompt analysis). Each is optional; an engine without a key is reported unavailable. ---
# OpenAI (ChatGPT answers) — platform.openai.com → API keys
OPENAI_API_KEY=
# Anthropic (Claude answers, and the model that reads every answer) — console.anthropic.com → API keys
ANTHROPIC_API_KEY=
# Google Gemini (Gemini answers) — aistudio.google.com → Get API key
GEMINI_API_KEY=
