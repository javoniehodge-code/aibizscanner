{
  "name": "aibizscanner-internal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --trace off",
    "report:schema": "tsx scripts/report/export-json-schema.ts",
    "report:extract-fixtures": "node scripts/report/extract-legacy-fixtures.mjs",
    "db:types": "supabase gen types --lang typescript -s public --workdir .. > src/lib/database.types.ts",
    "report:sync": "node scripts/report/sync-template.mjs",
    "predev": "npm run report:sync",
    "prebuild": "npm run report:sync",
    "pretypecheck": "npm run report:sync",
    "pretest": "npm run report:sync"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
